{
  "expo": {
    "name": "EngenharQ OS",
    "slug": "engenharq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "engenharq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos de acesso à câmera para ler QR Codes de crachás e EPIs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos de acesso à câmera para ler QR Codes de crachás e EPIs."
        }
      ]
    ]
  }
}
